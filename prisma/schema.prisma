generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model RecommendationScenario {
  id                   String                  @id @default(cuid())
  code                 String                  @unique
  displayName          String
  resultHeading        String                  @map("heading")
  resultDescription    String                  @map("description")
  enabled              Boolean                 @default(true)
  displayOrder         Int
  isCore               Boolean                 @default(false)
  groupType            String                  @default("SCENARIO")
  sections             RecommendationSection[]
  legacyAffiliateLinks LegacyAffiliateLink[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([groupType, enabled, displayOrder])
}

model RecommendationSection {
  id                 String                 @id @default(cuid())
  scenarioId         String
  scenario           RecommendationScenario @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  title              String
  description        String
  enabled            Boolean                @default(true)
  displayOrder       Int
  maxProducts        Int                    @default(3)
  collapsedByDefault Boolean                @default(false)
  layout             String                 @default("grid")
  purpose            String                 @default("GENERAL")
  isCore             Boolean                @default(false)
  products           AffiliateProduct[]
  assignments        RecommendationAssignment[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([scenarioId, enabled, displayOrder])
}

model Product {
  id                  String                     @id @default(cuid())
  title               String
  canonicalName       String
  componentType       String
  shortDescription    String                     @default("")
  imageUrl            String?
  retailer            String                     @default("Other")
  affiliateUrl        String
  defaultPriceText    String                     @default("Check current price")
  platform            String?
  enabled             Boolean                    @default(true)
  assignments         RecommendationAssignment[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([canonicalName])
  @@index([componentType, enabled])
  @@index([retailer, enabled])
}

model RecommendationAssignment {
  id                  String                @id @default(cuid())
  productId           String
  product             Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  sectionId           String
  section             RecommendationSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  badge               String                @default("None")
  buttonText          String                @default("View Product")
  overridePriceText   String?
  overrideDescription String?
  enabled             Boolean               @default(true)
  displayOrder        Int
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([sectionId, enabled, displayOrder])
  @@index([productId, enabled])
}

model AffiliateProduct {
  id               String                @id @default(cuid())
  sectionId        String
  section          RecommendationSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  title            String
  retailer         String
  affiliateUrl     String
  imageUrl         String?
  priceText        String
  shortDescription String
  badge            String
  buttonText       String
  componentType    String
  platform         String?
  enabled          Boolean               @default(true)
  displayOrder     Int
  legacySourceType String?
  legacySourceId   String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([legacySourceType, legacySourceId, sectionId])
  @@index([sectionId, enabled, displayOrder])
}

// Retained as a migration/rollback source so no existing affiliate records are
// dropped. New admin and public writes use AffiliateProduct above.
model LegacyAffiliateLink {
  id               String                 @id @default(cuid())
  title            String
  retailer         String
  affiliateUrl     String
  imageUrl         String?
  priceText        String
  badge            String
  shortDescription String
  buttonText       String
  componentType    String
  enabled          Boolean                @default(true)
  displayOrder     Int
  scenarioId       String
  scenario         RecommendationScenario @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([scenarioId, enabled, displayOrder])
  @@map("AffiliateLink")
}

model GamePurchaseLink {
  id            String   @id @default(cuid())
  enabled       Boolean  @default(false)
  title         String
  description   String
  platform      String
  retailer      String
  affiliateUrl  String
  buttonText    String
  imageUrl      String?
  releaseStatus String
  displayOrder  Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([enabled, displayOrder])
}

model AdGlobalSettings {
  id                    String   @id
  masterEnabled         Boolean  @default(false)
  defaultProvider       String   @default("disabled")
  adsenseClient         String   @default("")
  debugPlaceholders     Boolean  @default(false)
  defaultLabel          String   @default("Advertisement")
  defaultResponsive     Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

model AdPlacement {
  id                String   @id
  code              String   @unique
  displayName       String
  description       String
  enabled           Boolean  @default(false)
  provider          String   @default("disabled")
  useGlobalClient   Boolean  @default(true)
  adClientOverride  String   @default("")
  adSlot            String   @default("")
  format            String   @default("auto")
  responsive        Boolean  @default(true)
  deviceTarget      String   @default("both")
  label             String   @default("")
  displayOrder      Int
  customHtml        String   @default("")
  customHtmlTrusted Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  @@index([enabled, displayOrder])
  @@index([provider, enabled])
}

model EmailSubscriber {
  id                String    @id @default(cuid())
  email             String
  normalizedEmail   String    @unique
  unsubscribeKey    String    @unique @default(cuid())
  gtaUpdatesConsent Boolean   @default(true)
  marketingConsent  Boolean   @default(false)
  scenario          String?
  signupSource      String
  status            String    @default("active")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  unsubscribedAt    DateTime?
  lastEmailSentAt   DateTime?

  @@index([status, createdAt])
  @@index([scenario, status])
  @@index([signupSource, status])
  @@index([gtaUpdatesConsent, status])
  @@index([marketingConsent, status])
}

model Article {
  id                    String           @id @default(cuid())
  title                 String
  slug                  String           @unique
  excerpt               String           @default("")
  body                  String           @default("")
  featuredImage         String?
  authorName            String           @default("CanMyPCRunGTA6")
  status                String           @default("draft")
  publishedAt           DateTime?
  scheduledAt           DateTime?
  featured              Boolean          @default(false)
  contentType           String           @default("standard")
  seoTitle              String           @default("")
  metaDescription       String           @default("")
  canonicalUrl          String?
  openGraphTitle        String           @default("")
  openGraphDescription  String           @default("")
  openGraphImage        String?
  twitterTitle          String           @default("")
  twitterDescription    String           @default("")
  twitterImage          String?
  robotsIndex           Boolean          @default(true)
  robotsFollow          Boolean          @default(true)
  focusKeyword          String           @default("")
  schemaType            String           @default("Article")
  noindex               Boolean          @default(false)
  categories            ArticleCategory[]
  tags                  ArticleTag[]
  relatedArticles       ArticleRelated[] @relation("ArticleRelatedSource")
  relatedTo             ArticleRelated[] @relation("ArticleRelatedTarget")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([status, publishedAt])
  @@index([status, scheduledAt])
  @@index([featured, status])
}

model ContentPage {
  id                    String   @id @default(cuid())
  title                 String
  slug                  String   @unique
  body                  String   @default("")
  excerpt               String   @default("")
  featuredImage         String?
  status                String   @default("draft")
  pageTemplate          String   @default("standard")
  navigationLabel       String   @default("")
  showInNavigation      Boolean  @default(false)
  navigationOrder       Int      @default(0)
  publishedAt           DateTime?
  seoTitle              String   @default("")
  metaDescription       String   @default("")
  canonicalUrl          String?
  openGraphTitle        String   @default("")
  openGraphDescription  String   @default("")
  openGraphImage        String?
  twitterTitle          String   @default("")
  twitterDescription    String   @default("")
  twitterImage          String?
  robotsIndex           Boolean  @default(true)
  robotsFollow          Boolean  @default(true)
  focusKeyword          String   @default("")
  schemaType            String   @default("WebPage")
  noindex               Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([showInNavigation, navigationOrder])
}

model ContentCategory {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  description     String            @default("")
  imageUrl        String?
  displayOrder    Int               @default(0)
  seoTitle        String            @default("")
  metaDescription String            @default("")
  articles        ArticleCategory[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([displayOrder, name])
}

model ContentTag {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  articles  ArticleTag[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([name])
}

model ArticleCategory {
  articleId  String
  article    Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  categoryId String
  category   ContentCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  isPrimary  Boolean         @default(false)

  @@id([articleId, categoryId])
  @@index([categoryId, isPrimary])
}

model ArticleTag {
  articleId String
  article   Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tagId     String
  tag       ContentTag @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([articleId, tagId])
  @@index([tagId])
}

model ArticleRelated {
  articleId        String
  article          Article @relation("ArticleRelatedSource", fields: [articleId], references: [id], onDelete: Cascade)
  relatedArticleId String
  relatedArticle   Article @relation("ArticleRelatedTarget", fields: [relatedArticleId], references: [id], onDelete: Cascade)
  displayOrder     Int     @default(0)

  @@id([articleId, relatedArticleId])
  @@index([relatedArticleId])
}

model ContentRevision {
  id               String   @id @default(cuid())
  contentId        String
  contentKind      String
  titleSnapshot    String
  bodySnapshot     String
  editorIdentifier String?
  createdAt        DateTime @default(now())

  @@index([contentKind, contentId, createdAt])
}

model MediaAsset {
  id               String       @id @default(cuid())
  filename         String
  originalFilename String       @default("")
  url              String       @unique
  sourceType       String       @default("upload")
  storageProvider  String       @default("local")
  mimeType         String
  width            Int?
  height           Int?
  fileSize         Int
  altText          String       @default("")
  title            String       @default("")
  storageKey       String       @unique
  folderId         String?
  folder           MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([filename, createdAt])
  @@index([sourceType, createdAt])
  @@index([folderId, createdAt])
}

model MediaFolder {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  displayOrder Int          @default(0)
  media        MediaAsset[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([displayOrder, name])
}

model SiteContent {
  key         String   @id
  label       String
  value       String   @default("")
  contentType String   @default("text")
  group       String   @default("General")
  updatedAt   DateTime @updatedAt

  @@index([group, label])
}

model Redirect {
  id              String   @id @default(cuid())
  sourcePath      String   @unique
  destinationPath String
  statusCode      Int      @default(301)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled, sourcePath])
}
