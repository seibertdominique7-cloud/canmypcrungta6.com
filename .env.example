# Neon pooled connection used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
# Neon direct connection used by Prisma CLI migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-long-random-secret
AFFILIATE_RECOMMENDATION_LIMIT="3"
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS=""
EMAIL_UNSUBSCRIBE_SECRET="replace-with-at-least-32-random-characters"
SITE_URL="https://canmypcrungta6.com"
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
MEDIA_STORAGE_PROVIDER="local"
MEDIA_MAX_UPLOAD_MB="8"

# Fourthwall Storefront API. Keep the token server-only.
FOURTHWALL_STOREFRONT_TOKEN=
NEXT_PUBLIC_FOURTHWALL_CHECKOUT_URL="https://shop.example.com"

# Google Analytics 4 measurement ID. This identifier is intentionally public.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# AI SEO Publisher (server-only; supported providers: Gemini and OpenAI)
AI_SEO_PROVIDER="gemini"
AI_SEO_MODEL="gemini-3.6-flash"
AI_SEO_FALLBACK_MODEL="gemini-3.5-flash-lite"
AI_SEO_TIMEOUT_MS="90000"
GEMINI_API_KEY=
OPENAI_API_KEY=

# Google AdSense remains off until enabled with a valid publisher and placement IDs.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADS_DEBUG=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_HOMEPAGE_SLOT=
NEXT_PUBLIC_ADSENSE_RESULTS_SLOT=
NEXT_PUBLIC_ADSENSE_ARTICLE_TOP_SLOT=
NEXT_PUBLIC_ADSENSE_ARTICLE_MIDDLE_SLOT=
NEXT_PUBLIC_ADSENSE_ARTICLE_BOTTOM_SLOT=
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT=
NEXT_PUBLIC_ADSENSE_FOOTER_SLOT=

# Only the variables for the selected MEDIA_STORAGE_PROVIDER are required.
BLOB_READ_WRITE_TOKEN=""
CLOUDINARY_URL=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional for S3-compatible services and CDN delivery:
S3_ENDPOINT=""
S3_PUBLIC_BASE_URL=""
